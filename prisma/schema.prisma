// Prisma schema for FD-Management.
//
// Single-file SQLite database — backup is a copy of the file (see
// docs/tech_stack_architecture_sketch.md §3, §6). The schema doubles as readable domain
// documentation; the distribution and attendance models arrive in later sessions.
//
// One rule this file cannot state on its own: **at most one non-archived customer may hold a given
// customer number.** Prisma has no syntax for a partial (filtered) unique index, so the statement
// lives at the end of prisma/migrations/*_init/migration.sql, written by hand. Regenerating the
// migration drops it — re-add it, or the slot rule is enforced by application code alone.
//
// Money is always an `Int` of whole cents. SQLite has no decimal type and a float would round a
// price away, so `Float` and `Decimal` appear nowhere in this file.
//
// Note: the walking skeleton uses Prisma's native SQLite provider. Wiring the `better-sqlite3`
// driver adapter (named in the stack doc) is deferred until the database grows beyond settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One immutable set of the policy values DF can change without a deploy: the customer quota, the
/// price per head and the week-cycle anchor.
///
/// Versions are **append-only**: the sole way to answer "what would that household owe under the
/// policy of last March" is to resolve the version that was in force then
/// (tasks/prd-us-14-configure-business-rules.md, FR-1). A hand-out captures the price it was taken
/// at, so a past record can be read without replaying them — but only records that were written.
model SettingsVersion {
  id Int @id @default(autoincrement())

  /// The instant these values took over — stamped from the clock when staff saved them, never a
  /// date they pick: a change applies immediately. Deliberately **not** unique; two saves in the
  /// same millisecond are a concurrency accident, not a business error, and the later row wins.
  recordedAt DateTime

  /// The maximum number of customer slots DF hands out.
  quotaN Int

  /// The known week of the two-week cycle everything else is counted from, e.g. `2026-W02`, and the
  /// group that collected in it (`RED` or `BLUE`). SQLite has no enum type, so the colour is a
  /// string the domain validates on the way in and out.
  weekAnchorIsoWeek String
  weekAnchorColour  String

  /// Distribution day as an ISO weekday, Monday = 1 … Sunday = 7.
  distributionWeekday Int

  /// What one grown-up and one child each pay, in whole euro cents. DF charges per head, so what a
  /// household owes is derived — `grownUps × pricePerGrownUpCents + children × pricePerChildCents`,
  /// capped by `priceCapCents` below — and never stored on this row.
  pricePerGrownUpCents Int
  pricePerChildCents   Int

  /// The most one household pays for one distribution, whatever its size — DF's *Maximalpreis*.
  ///
  /// **Nullable because absent is a real configuration, not a missing value:** NULL means there is
  /// no cap and every household pays the per-head sum. It is deliberately not a `0` sentinel,
  /// because `0` already means something else on this row — a cap of `0` is a coherent setting that
  /// makes every distribution free — and the two must stay distinguishable on the settings screen.
  priceCapCents Int?

  /// The egg allowance in force with these values — the staircase of household sizes and the eggs
  /// each one receives (US-28). A version with no rows is a legitimate configuration and means no
  /// eggs for anyone, so an empty list is never read as "not configured".
  eggRule EggAllowanceRow[]

  @@index([recordedAt])
}

/// One step of the egg staircase: from `minPersons` people in the household, `eggs` eggs
/// (tasks/prd-us-28-egg-allowance.md §US-28.5). A household receives the eggs of the highest
/// threshold it reaches, and none when it reaches none.
///
/// **Why rows and not a JSON column or three fixed columns.** This is the first list-valued policy
/// value, and the shape it takes is the precedent for the next one. A JSON blob would be one opaque
/// string the schema could not document and the database could not constrain — the thresholds and
/// the counts are typed integers, and they are worth keeping typed. Three columns would be worse
/// still: DF's rule today has three steps (3 → 6, 5 → 12, 8 → 18), and pinning that into the schema
/// would make *their current configuration* part of the software, which is the whole thing US-14
/// and ADR-005 exist to avoid. Rows are added and removed on the settings screen; the table has to
/// let them be.
///
/// Belongs to exactly one `SettingsVersion` and is written with it. Versions are append-only, so
/// these rows are too: a change to the rule is a new version carrying a new set of rows, never an
/// edit to these.
model EggAllowanceRow {
  id Int @id @default(autoincrement())

  /// `onDelete: Restrict` is stated out loud even though the relation is required and Prisma would
  /// default to it. Every relation in this file says which action it takes, so a reader never has
  /// to know Prisma's defaults to see that nothing here is destructive — and the nullable relations,
  /// where the default *is* destructive, look no different from the required ones.
  settingsVersionId Int
  settingsVersion   SettingsVersion @relation(fields: [settingsVersionId], references: [id], onDelete: Restrict)

  /// The household size this step starts at, counted in **people of any age**: an infant is a
  /// person, so two grown-ups and one baby is three. Never a count of grown-ups or of children —
  /// a 13th birthday moves those and the price, and leaves the eggs where they were.
  minPersons Int

  /// How many eggs a household reaching `minPersons` receives. Whole eggs, because eggs are handed
  /// over one at a time; nothing requires a multiple of six, and zero is a legal step.
  eggs Int

  /// Not decoration: this is the no-duplicate-threshold rule (FR-4) enforced a second time, by the
  /// database. `createEggRule` refuses a rule naming one household size twice, and this index is
  /// what makes that hold for a row inserted by anything other than the domain — the same division
  /// of labour as `Card`'s unique indexes.
  @@unique([settingsVersionId, minPersons])
  /// A version's rule is read whole, every time the settings history is resolved.
  @@index([settingsVersionId])
}

/// A household DF serves.
///
/// `id` is the surrogate key and the **only identity** there is. `customerNumber` is a *slot*: it is
/// what staff and the customer's card say, but an archived household releases it and the next
/// registration fills the gap (tasks/prd-us-01-register-customer.md §US-01.2). Confusing the two is
/// the mistake the Excel sheet made, so every foreign key in this file targets `id` and never
/// `customerNumber`.
///
/// **There is deliberately no `grownUps` and no `children` column.** Both are derived from the
/// household's birthdates wherever they are needed (`src/domain/customer/householdComposition.ts`);
/// stored, they would drift with every birthday — which is exactly what they did in the sheet.
///
/// **Nothing a household owns cascades.** No relation in this file carries `onDelete: Cascade`, so
/// SQLite *refuses* to delete a customer who has members, a certificate, a card, a distribution
/// record or a reminder log — the row must be archived instead (US-10.3). A cascade would be
/// harmless as long as no code ever calls `delete`, which is precisely why it is the wrong thing to
/// leave lying about: the day a clean-up script or a mistyped test does call it, the household's
/// history goes with it silently. Refusing the delete turns that into a loud error.
///
/// SQLite has no enum type, so `group` and `status` are strings the domain validates on the way in.
model Customer {
  id Int @id @default(autoincrement())

  /// The slot this household holds, 1..`quotaN`. Not unique on its own — see the partial unique
  /// index added by hand in the migration, which exempts archived rows.
  customerNumber Int

  firstName String
  lastName  String
  birthDate DateTime

  /// The two names as `src/domain/customer/nameSearch.ts` folds them for comparison: lower-cased,
  /// `ä → ae`, `ß → ss`, remaining diacritics dropped. Written beside the names they come from, so
  /// the archive search (US-11.1) can compare an indexed column instead of every row — SQLite has no
  /// `unaccent` and its `LIKE` folds only ASCII case, so the fold cannot live in the query.
  ///
  /// This is the one derived value stored outside a card snapshot, and it is a *search key*, not a
  /// fact: nothing reads it as the household's name, and the names above remain the only spelling
  /// the software ever shows. Because it is stored, it can go stale — so it is **not nullable and
  /// has no default**, which makes every writer state it, and the adapter derives both from the
  /// names in the same statement. A name that is ever edited (US-16) must rewrite them with it.
  firstNameFolded String
  lastNameFolded  String

  /// The address in flat fields, never a formatted blob: DF sorts and searches by them.
  street      String
  houseNumber String
  zip         String
  city        String

  /// The balancing group, `RED` or `BLUE` — which week of the two-week cycle they collect in.
  group String

  /// `ACTIVE`, `BLOCKED` or `ARCHIVED`. A blocked household is turned away at the counter but still
  /// holds its slot; only archiving releases it. Customer data is never hard-deleted (US-10, US-11).
  status String

  /// Why the household is currently blocked, or null when it is not — non-null **exactly** when
  /// `status` is `BLOCKED`. A block's reason is its only current record (US-08, FR-1); it is written
  /// when the block goes on and cleared when it is lifted. The audit log keeps the history, this
  /// column keeps what the counter must show today.
  blockReason String?

  /// Why this household was archived and when, or null while it is not — non-null **exactly** when
  /// `status` is `ARCHIVED`. Archiving is irreversible (US-10, FR-7), so unlike `blockReason` the
  /// pair is written once and never cleared: it is what the archived record shows about itself long
  /// after the audit entry has scrolled out of sight. Neither frees the slot — the partial unique
  /// index does that off `status` alone, and `customerNumber` stays for the historical record.
  archiveReason String?
  archivedAt    DateTime?

  /// How many certificate reminders have gone out (US-06).
  reminderCount Int @default(0)

  /// A free remark, or the empty string. Most households need none.
  notes String @default("")

  /// The archived record this registration was pre-filled from, or null (US-11.3).
  ///
  /// **Display metadata: no rule reads it, and none may start.** A household that comes back is a
  /// new customer with a new number, a card at index 1 and a reminder count of zero; this column
  /// only says that the same people were once here before, so a future "history of this household"
  /// view is additive (tasks/prd-us-11-reuse-archived-record.md §7). It is never a merge — nothing
  /// is carried across it, and the predecessor stays exactly as archiving left it (FR-5).
  ///
  /// Self-referencing and nullable, with `onDelete: Restrict` like every other relation here: the
  /// link may not be silently nulled by a delete any more than a household may be deleted at all.
  previousCustomerId Int?
  previousCustomer   Customer?  @relation("Reregistration", fields: [previousCustomerId], references: [id], onDelete: Restrict)
  successors         Customer[] @relation("Reregistration")

  householdMembers HouseholdMember[]
  certificates     Certificate[]
  cards            Card[]
  distributions    DistributionRecord[]
  reminderLogs     ReminderLog[]

  @@index([customerNumber])
  @@index([status])
  /// The customer list's group filter and its group-balance counts (US-15.2). `status` above serves
  /// the status filter, and the counts read both columns — the two are separate indexes rather than
  /// one pair because each is also asked on its own.
  @@index([group])
  /// The archive search (US-11.1): a folded last-name prefix, optionally narrowed by the birthdate.
  /// Both columns are in one index because they are typed together — the name identifies the family
  /// and the birthdate tells two namesakes apart.
  ///
  /// It also serves the customer list's name search, which is a prefix of the *folded* last name —
  /// the spelled column is never compared, so it is deliberately not indexed (US-15.2).
  @@index([lastNameFolded, birthDate])
  /// The other half of that search's `OR`: staff type whichever of the two names they were given, so
  /// a first-name prefix must be servable from an index too, or half the query scans the register.
  @@index([firstNameFolded])
}

/// One person living in the household, the registered customer included.
///
/// Only a name and a birthdate: the birthdate is what every rule that counts heads reads, and no
/// count is stored anywhere.
///
/// Like every other relation in this file there is **no `onDelete: Cascade`** — see the note on
/// `Customer`.
model HouseholdMember {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  firstName String
  lastName  String
  birthDate DateTime

  @@index([customerId])
}

/// The proof of need that entitles a household to shop, e.g. a Jobcenter notice.
///
/// Rows are **appended, never overwritten**: a renewal stacks a new row rather than editing the
/// dates, so the history of renewals stays readable (US-06.3, FR-8). The certificate *on file* is
/// the latest by `recordedAt` — the counter only ever reads that one, but the trail behind it says
/// when each renewal was brought.
model Certificate {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  /// What kind of notice it is, as staff typed it.
  type String

  /// The day it stops entitling the household. What the reminder in US-06 counts down to.
  validUntil DateTime

  /// The instant this certificate was recorded, from the injected clock — the registration for the
  /// first row, the renewal for every later one. What "latest" is decided by.
  recordedAt DateTime

  @@index([customerId, recordedAt])
}

/// A shopping card handed to a customer.
///
/// `index` counts the cards issued on a *customer number*, across every household that has ever held
/// it: the first card printed under a slot is 1 and each further one — a reissue after a loss (US-09),
/// or the first card of the household that later fills the freed slot — takes the next index. A card
/// number therefore names one physical card for good (US-25). The card number staff read out is
/// derived from the customer number and this index, never stored.
model Card {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The slot this card was printed under — `Customer.customerNumber` as it stood, which is to say
  /// as it will always stand: a number is fixed at registration and released only by archiving
  /// (US-24, Non-Goals), so unlike the three `AtIssue` columns below this one snapshots nothing.
  /// There is no moment at which it could come to differ from the customer's number.
  ///
  /// It is stored for the same reason `Customer.firstNameFolded` is: a **key the constraint needs**.
  /// `@@unique([customerNumber, index])` cannot reach through the relation, and the guarantee that a
  /// card number is never handed out twice has to rest on the database rather than on every future
  /// caller remembering to ask the right question first. Not nullable and with no default, so every
  /// writer must state it; the adapter reads it off the customer row in the same transaction as the
  /// insert, so the two can never disagree.
  ///
  /// Never read as the card's number. What a card number *is* remains
  /// `formatCardNumber(customer.customerNumber, card.index)`, derived at every read.
  customerNumber Int

  index    Int
  issuedAt DateTime

  /// The grown-up and children counts **as they were printed on this piece of card**, derived from
  /// the household's birthdates at the moment it was issued.
  ///
  /// This is the only count stored anywhere in this file, and it is deliberate: it is a **snapshot
  /// of a physical object**, not the household's truth. `Customer` still has no count column and
  /// never will — what the household *is* today is always derived from the birthdates
  /// (`src/domain/customer/householdComposition.ts`). These two columns exist because the printed
  /// card is out in the world and its numbers stop being true the moment a child turns 13; without
  /// them there is nothing to compare against, and the cards-due-for-reissue list (US-13.2) could
  /// not exist.
  ///
  /// So: do not "fix" this duplication, and never update these values in place. A card whose
  /// printed counts have been overtaken is replaced by a new card with reason `STALE_COUNTS` — the
  /// reissue *is* how the change is recorded.
  grownUpsAtIssue Int
  childrenAtIssue Int

  /// The group **as it was printed on this piece of card** — the same kind of snapshot as the two
  /// counts above, and stored for the same single purpose. The card is what tells the household
  /// which week to come in, so moving them between groups makes the printed card wrong even though
  /// nothing about the household changed; without this column there is nothing to notice that
  /// against, and a group change could not reach the cards-due list (US-16.4).
  ///
  /// Nothing reads it as the household's group — that is `Customer.group`, the only editable one.
  /// Like the counts it is never updated in place: a reissue is how the change is recorded.
  ///
  /// SQLite has no enum type, so the word is a string the domain validates on the way in and out.
  groupAtIssue String

  /// Why this card was handed over: `FIRST_ISSUE`, `LOST`, `STALE_COUNTS`, `CUSTOMER_NUMBER_CHANGED`
  /// or `OTHER`. SQLite has no enum type, so the word is a string the domain validates on the way in
  /// and out — which is why a fifth word costs the database nothing. It is the one thing about a
  /// superseded card that its index cannot say — why the household needed another one.
  reason String

  /// The rule behind "exactly one valid card" (US-02, FR-3): validity is *being* the highest index,
  /// so two cards sharing one would leave no current card at all. This constraint, not the
  /// application, is the final authority on whether an index was still free when the write landed.
  ///
  /// It stays beside the global one below because it settles a different fact — a race between two
  /// reissues on *one record* — and a lost race there is answered by re-reading the record, whereas a
  /// duplicate card number is answered by re-reading the slot's whole run. The two therefore surface
  /// as two different domain errors.
  @@unique([customerId, index])
  /// A card number is never handed out twice (US-25). Without this, a household registering on a slot
  /// an archived household released would be printed a card the departed household is still carrying,
  /// and the counter would answer "Ausgabe frei" to it.
  ///
  /// **No separate `@@index([customerNumber])` is needed**: `customerNumber` is this index's leading
  /// column, so `MAX(index) WHERE customerNumber = ?` — the one question the counting rule asks — is
  /// served by it already. A second index would only be there to feel safe.
  @@unique([customerNumber, index])
}

/// One hand-out that actually happened: a customer showed up on a distribution day, handed over an
/// amount, and owed the price their household drew under the policy in force then (US-05, FR-1).
///
/// **Records outlive their customer.** There is deliberately no `onDelete: Cascade` on the relation:
/// archiving is a status change, not a delete, and the distribution history must survive it — a report
/// of who collected last March cannot depend on the household still being on the register (US-10,
/// US-11). Customer data is never hard-deleted anyway, so the foreign key only ever points at a row
/// that is still there.
///
/// The once-per-distribution-day rule (FR-5) lives in the domain (`attendance.canRecord`), but the
/// database is its final authority: `dayKey` is a normalised Europe/Berlin calendar-day string
/// (`YYYY-MM-DD`, filled by `berlinDayKey` so it matches the domain rule exactly), and the unique
/// `(customerId, dayKey)` index means a second hand-out on the same day cannot be written even if two
/// requests race past the use case's guard. The raw `date` instant is kept alongside it for the
/// no-show query (US-10) and for display.
model DistributionRecord {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The instant the hand-out was recorded, from the injected clock. Its Berlin calendar day is
  /// `dayKey`; both are stored so the once-per-day constraint never has to reinterpret the instant.
  date DateTime

  /// The Europe/Berlin calendar day of `date` as `YYYY-MM-DD`. Not derivable in SQLite (no timezone
  /// arithmetic), so it is written by the domain's `berlinDayKey` and the unique index below rests on
  /// it. Never a UTC or naive date — see the comment on `src/domain/distribution/attendance.ts`.
  dayKey String

  /// Whether the customer showed up. Always true today — a no-show writes no record at all (FR-6).
  showedUp Boolean

  /// What the household handed over, in whole euro cents — the amount, not a flag (US-29). It may
  /// be less than they were asked for (a part payment) and occasionally more (they pay ahead), so a
  /// boolean could not hold it. `0` is "handed over nothing" and is stored as `0`, never as null.
  ///
  /// The household's **balance is derived** from this column and `priceCents` over their hand-outs
  /// (`Σ (paidCents − priceCents)`), and is never stored: a stored balance beside the rows that
  /// produce it would be two answers to one question.
  paidCents Int

  /// What the household owed under the policy in force on `date`, in whole euro cents. This is
  /// **deliberate redundancy** alongside the settings history (PRD §6): the price could be re-derived
  /// by resolving the version in force then, but capturing it makes a record self-describing so later
  /// reporting can price a past distribution with a single-table read. It is not to be "cleaned up".
  priceCents Int

  @@unique([customerId, dayKey])
  @@index([date])
  @@index([customerId, date])
}

/// One applicant waiting for a customer number to free up (US-12).
///
/// An entry is **not a customer**: it holds no `customerNumber`, no group and no card, and it has no
/// relation to `Customer` at all — the whole point of the list is the people the quota has no slot
/// for, and a row here must never be mistaken for one that occupies one. When an applicant is
/// registered, a customer is created from scratch and this row is stamped as removed.
///
/// **Rows are retained, never deleted** (FR-7). Whether an applicant was registered or withdrew,
/// `removedOn` and `removalReason` say so and the row stays: "first come, first served" is a claim
/// DF must still be able to defend a year later, and it can only be checked against a history that
/// still contains the people who left it. The active list is therefore every row with
/// `removedOn IS NULL` — a filter, never a delete.
///
/// **There is deliberately no `position` column.** The place in the queue is `addedOn` (ties broken
/// by the ascending `id`), derived by `src/domain/customer/waitingList.ts`; a stored position is a
/// position somebody can edit, which is exactly the fairness the list exists to protect.
model WaitingListEntry {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String
  birthDate DateTime

  /// The address in flat fields, as on `Customer` — an applicant is asked the same questions a
  /// registration asks, so promoting them is a pre-filled form rather than a re-interview.
  street      String
  houseNumber String
  zip         String
  city        String

  /// How staff would reach this applicant, in free text, or null when none was given. DF agreed no
  /// phone or e-mail fields (docs/domain_analysis.md, open question 2), and nullable rather than
  /// defaulted because "we have no way of reaching them" is a fact about the entry worth seeing.
  contactNote String?

  /// The proof of need the applicant was admitted with, flattened onto the row. It is a single
  /// certificate rather than the appended history `Certificate` keeps, because nothing renews on the
  /// waiting list: an entry whose certificate lapses while waiting keeps its place and is *flagged*
  /// (FR-5), and a renewal is brought when they are registered.
  certificateType       String
  certificateValidUntil DateTime

  /// The instant the applicant joined, from the injected clock — their entire place in the queue.
  addedOn DateTime

  /// When they came off the list and why, or null while they are still waiting. Written together and
  /// never cleared: the pair is what turns a removal into a record instead of a gap.
  removedOn     DateTime?
  removalReason String?

  /// The queue is read in arrival order every time the screen or the banner asks who is next.
  @@index([addedOn])
}

/// One logged certificate reminder — a day of the documented trail an expired certificate starts at
/// the counter (US-06).
///
/// Entries are appended, never amended: a reminder that was given stays given, and a renewed
/// certificate resets the customer's *count*, not this log. `resultingCount` repeats the count as it
/// stood after the entry, so the trail is readable on its own without replaying it.
///
/// The once-per-day rule lives in the use case (`recordReminder`), but the unique
/// `(customerId, loggedOn)` index below is its final authority: a second reminder on the same day
/// cannot be written even if two requests race past the guard (US-06.3). Like `DistributionRecord`,
/// there is deliberately no `onDelete: Cascade` — the trail outlives status changes, and customer
/// data is never hard-deleted anyway.
model ReminderLog {
  id Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  /// The Europe/Berlin calendar day the reminder was given, as `YYYY-MM-DD`. Written by the domain's
  /// `berlinDayKey` — the same notion of "the same day" the attendance rule uses — and never a UTC
  /// or naive date, so the constraint and the guard cannot drift to two notions of "today".
  loggedOn String

  /// The customer's reminder count after this entry.
  resultingCount Int

  @@unique([customerId, loggedOn])
}

/// One append-only record of a state change: *what* changed, *when* and *why* — never *who*.
///
/// DF has ruled out login, so the system cannot tell its three or four staff apart and there is
/// deliberately no actor column (docs/tech_stack_architecture_sketch.md §5.2). With no login the log
/// is the only accountability the system has, so rows are never amended or deleted.
model AuditEntry {
  id Int @id @default(autoincrement())

  /// A stable, machine-readable event name such as `settings.updated`.
  what String

  /// The fields the change touched, comma-separated: SQLite has no array type, and the list is
  /// only ever read back for display.
  changedFields String

  /// When the change happened, read from the injected clock rather than the database.
  when DateTime

  /// The reason a human gave, or empty when none was asked for. A settings edit is self-explanatory
  /// from `changedFields`; the changes that turn on a judgement (block, archive) require one.
  why String

  @@index([when])
}
