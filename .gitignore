# Dependencies
/node_modules/

# Next.js build output
/.next/
/out/

# Generated by `next dev` / `next build` on every run, and marked "should not be edited".
# tsconfig.json still lists it under `include`; a missing entry there is not an error.
/next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo

# Test and coverage output
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Environment: `.env.example` is the tracked template, `.env` is the local copy
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# macOS
.DS_Store

# Prisma generated client
/src/generated/

# FD-Management: SQLite database (the data/ dir is tracked via .gitkeep, the db files are not)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# FD-Management: the instant the end-to-end suite pins the app's clock to (tests/e2e/distribution.spec.ts).
# A glob rather than a list: there is one of these per register per engine, and tests/e2e/registers.ts
# names them, so a new engine must not need a line here to stay untracked.
/data/e2e*-now.txt

# playwright-cli: per-session page snapshots, console logs and browser config, regenerated on every
# UI verification. Every UI change is driven through it (docs/guideline/ui_styling_guide.md §11), so
# these appear on any branch that touches a screen. Untracked and unignored, they would be swept into
# whatever commit came next — which for a Ralph batch of UI stories is every commit.
/.playwright/
/.playwright-cli/

# Personal scratch space: notes, exports, anything not meant for the repository.
/local_only/

# Claude Code: personal, machine-local settings (shared config lives in .claude/settings.json)
.claude/settings.local.json
.claude/**/*.local.json
.claude/local-rules/*
